{
  "name": "paza-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Paza Event Bot & Mini App Monorepo",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:frontend": "turbo dev --filter=frontend",
    "dev:backend": "turbo dev --filter=backend",
    "build:frontend": "turbo build --filter=frontend",
    "lint:frontend": "turbo lint --filter=frontend"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
