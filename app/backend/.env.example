# ==========================================
# APPLICATION
# ==========================================
ENVIRONMENT="development"
DEBUG=True
WEB_APP_URL="http://localhost:5173"

# ==========================================
# DATABASE & CACHE
# ==========================================
DATABASE_URL="postgres://user:password@host:port/dbname?sslmode=require"
REDIS_URL="rediss://default:password@host:port"

# ==========================================
# CLERK AUTHENTICATION
# ==========================================
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your-clerk-publishable-key"
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key"

# ==========================================
# N8N TWO-WAY INTEGRATION (API KEY PROTECTED)
# ==========================================
PIPELINE_API_KEY="your-secret-pipeline-api-key"
N8N_WEBHOOK_URL="https://your-n8n-instance/webhook/paza-scraper-result"
N8N_API_KEY="your-secret-n8n-webhook-api-key"

# ==========================================
# TELEGRAM BOT NOTIFICATION SETTINGS
# ==========================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# ==========================================
# LLM API KEYS
# ==========================================
GEMINI_API_KEY="your-gemini-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
GROQ_API_KEY="your-groq-api-key"

# ==========================================
# AWS S3 STORAGE (MATCHES TERRAFORM)
# ==========================================
AWS_REGION="us-east-1"
S3_BUCKET_NAME="paza-events-media"

# ==========================================
# SCRAPER SESSION CREDENTIALS
# ==========================================
INSTAGRAM_USERNAME="your-instagram-username"
INSTAGRAM_SESSION_ID="your-instagram-session-id"
TIKTOK_SESSION_ID="your-tiktok-session-id"
