{
  "name": "Paza Scraper Pipeline & Telegram Notifier",
  "nodes": [
    {
      "parameters": {
        "content": "## Paza Scraper <-> n8n Setup\n\n**Two-Way API Key Protection:**\n1. **Outbound (n8n -> Backend):** Create an HTTP Header Auth credential named `Paza Backend API Key` with header `X-Api-Key` = your `PIPELINE_API_KEY`.\n2. **Inbound (Backend -> n8n):** Create an HTTP Header Auth credential named `n8n Webhook API Key` with header `X-Api-Key` = your `N8N_API_KEY`.\n\n**Environment / URLs:**\n- Set `PAZA_BACKEND_URL` (e.g. `https://api.yourdomain.com`) in n8n or replace directly in the HTTP node.\n- Set `N8N_WEBHOOK_URL` in Paza backend `.env` to this Webhook's Production URL.\n- Configure your Telegram Bot credential & target chat ID in the Telegram node.",
        "height": 260,
        "width": 520,
        "color": 4
      },
      "id": "b7f3f9c0-1111-4000-8000-000000000001",
      "name": "Setup Instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        -40
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "b7f3f9c0-1111-4000-8000-000000000002",
      "name": "Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        280
      ]
    },
    {
      "parameters": {},
      "id": "b7f3f9c0-1111-4000-8000-000000000003",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        200,
        460
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.PAZA_BACKEND_URL || 'http://localhost:8000').replace(/\\/$/, '') }}/api/v1/scraper/trigger?async_mode=true",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"trigger_source\": \"n8n\",\n  \"notify_n8n\": true\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "b7f3f9c0-1111-4000-8000-000000000004",
      "name": "Trigger Paza Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_PAZA_BACKEND_API_KEY_CREDENTIAL_ID",
          "name": "Paza Backend API Key"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "paza-scraper-result",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b7f3f9c0-1111-4000-8000-000000000005",
      "name": "Pipeline Result Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        680
      ],
      "webhookId": "paza-scraper-result",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_N8N_WEBHOOK_API_KEY_CREDENTIAL_ID",
          "name": "n8n Webhook API Key"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.body.chat_id || '6329130782' }}",
        "text": "={{ $json.body.telegram_message }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "b7f3f9c0-1111-4000-8000-000000000006",
      "name": "Notify via Telegram Bot",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        680
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_BOT_CREDENTIAL_ID",
          "name": "Paza Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"received\": true, \"job_id\": $('Pipeline Result Webhook').item.json.body.job_id, \"status\": $('Pipeline Result Webhook').item.json.body.status } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b7f3f9c0-1111-4000-8000-000000000007",
      "name": "Acknowledge Backend",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        740,
        680
      ]
    }
  ],
  "connections": {
    "Every 2 Hours": {
      "main": [
        [
          {
            "node": "Trigger Paza Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Trigger Paza Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pipeline Result Webhook": {
      "main": [
        [
          {
            "node": "Notify via Telegram Bot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify via Telegram Bot": {
      "main": [
        [
          {
            "node": "Acknowledge Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "meta": {
    "templateCredsSetupCompleted": false
  }
}

